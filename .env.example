# Salin file ini menjadi ".env" lalu isi dengan data milikmu.
# JANGAN pernah membagikan file .env ke orang lain / upload ke publik (GitHub, dll).

# Token bot Discord (Developer Portal > Applications > Bot > Reset Token)
DISCORD_BOT_TOKEN=isi_token_bot_disini

# ID server (guild) Discord yang mau dipantau
# Cara ambil: aktifkan Developer Mode di Discord (Settings > Advanced),
# lalu klik kanan nama server > Copy Server ID
DISCORD_GUILD_ID=isi_guild_id_disini

# Port lokal untuk menjalankan dashboard (default 3000)
PORT=3000
